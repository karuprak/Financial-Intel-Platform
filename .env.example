# AWS Credentials
# Create an IAM user in AWS Console with S3 access
# and paste the keys here
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# S3 Bucket Name
# Create an S3 bucket in AWS Console and paste the name here
S3_BUCKET_NAME=your_bucket_name_here